{
  "description": "TDQ workflow: reminders on edit/bash + Stop reminder for the working log + state context injection + the search gate (blocks code searches that skip the concept layer)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_start.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt_context.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt_context.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt_context.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/edit_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/edit_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/edit_gate.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/read_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/read_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/read_gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash_gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Grep|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_gate.py\""
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_tdq-workflow_)?lsp__(start_lsp|blast_radius)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lsp_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lsp_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lsp_gate.py\""
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_tdq-workflow_)?lsp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask_gate.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent|invoke_subagent|swarm|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PreToolUse || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PreToolUse || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_tdq-workflow_)?lsp__.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent|invoke_subagent|swarm|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PostToolUse || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PostToolUse || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__(plugin_tdq-workflow_)?lsp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/search_observe.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event SubagentStop || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event SubagentStop || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_stop.py\" --event SubagentStop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_gate.py\""
          }
        ]
      }
    ]
  }
}
