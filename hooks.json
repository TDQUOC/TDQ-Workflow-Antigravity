{
  "tdq-session-start": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/tdq_hook_launcher.mjs --event SessionStart"
      }
    ]
  },
  "tdq-pre-invocation": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/tdq_hook_launcher.mjs --event PreInvocation"
      }
    ]
  },
  "tdq-pre-tool-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_to_file|write_file|replace_file_content|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "grep_search|find_by_name|list_dir|search_directory|find_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "mcp_.*|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "ask_question|ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "invoke_subagent|swarm|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PreToolUse"
          }
        ]
      }
    ]
  },
  "tdq-post-tool-observe": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "grep_search|find_by_name|list_dir|search_directory|find_file|list_directory|mcp_.*(lsp|graphify|txtai).*|call_mcp_tool|invoke_subagent|swarm|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/tdq_hook_launcher.mjs --event PostToolUse"
          }
        ]
      }
    ]
  },
  "tdq-post-invocation": {
    "enabled": true,
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/tdq_hook_launcher.mjs --event PostInvocation"
      }
    ]
  },
  "tdq-stop-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/tdq_hook_launcher.mjs --event Stop"
      }
    ]
  }
}
